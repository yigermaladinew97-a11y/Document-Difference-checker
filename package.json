{
  "name": "document-difference-checker",
  "version": "1.0.0",
  "description": "Multi-format document comparison system with word-level diff, contextual analysis, and beautiful UI",
  "main": "server.js",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "build": "npm --prefix client install && npm --prefix client run build",
    "dev": "node --watch server.js",
    "client:dev": "cd client && npm run dev",
    "test:parsers": "node test-parsers.js",
    "test:comparator": "node test-comparator.js",
    "test:ai": "node test-ai.js",
    "test:server": "node test-server.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "adm-zip": "^0.5.16",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "diff": "^7.0.0",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "mammoth": "^1.9.0",
    "multer": "^1.4.5-lts.1",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "unpdf": "^2.2.0",
    "xlsx": "^0.18.5"
  }
}
