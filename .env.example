# Document Difference Checker - Environment Configuration
PORT=3000

# Optional: Google Gemini API Key for AI-powered semantic reasoning & plain-English summaries
# Users can also supply their own key directly in the UI settings
GEMINI_API_KEY=your_gemini_api_key_here

# Required in production. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long

# Optional comma-separated browser origins for cross-origin API clients.
# Same-origin deployments can leave this empty.
CORS_ORIGINS=

# Optional: NODE_ENV (development | production)
NODE_ENV=production

# Optional: Email Service for Two-Factor Authentication (2FA) emails
# Option 1 (Recommended - 1 Click): Resend API key from resend.com (free 3,000 emails/mo)
RESEND_API_KEY=

# Option 2: Generic SMTP server (Gmail, SendGrid, Mailgun, Brevo)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM="ydiff" <security@ydiff.io>
